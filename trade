using UnityEngine;

public enum MarketDemand
{
    VeryLow,   // Talep ölü (Çarpan: 0.6)
    Low,       // Düşük talep (Çarpan: 0.8)
    Normal,    // Standart (Çarpan: 1.0)
    High,      // Popüler / Aranan (Çarpan: 1.25)
    Trending   // Trend / Aşırı revaçta (Çarpan: 1.5)
}

public static class ItemValuationSystem
{
    // -------------------------------------------------------------
    // 1. ADIM: EŞYANIN GERÇEK PİYASA DEĞERİNİ HESAPLAMA (OBJEKTİF)
    // -------------------------------------------------------------
    // Formül: BaseValue * Condition * Rarity * Authenticity * Demand
    public static float CalculateTrueMarketValue(PawnShopItem item, MarketDemand demand = MarketDemand.Normal)
    {
        float baseVal = item.template.baseValue;

        // Kondisyon Çarpanı
        float conditionMultiplier = GetConditionMultiplier(item.condition);

        // Nadirlik Çarpanı
        float rarityMultiplier = GetRarityMultiplier(item.template.rarity);

        // Orijinallik Çarpanı
        float authenticityMultiplier = GetAuthenticityMultiplier(item.authenticity);

        // Piyasa Talebi Çarpanı
        float demandMultiplier = GetDemandMultiplier(demand);

        // Net Gerçek Değer
        float trueValue = baseVal * conditionMultiplier * rarityMultiplier * authenticityMultiplier * demandMultiplier;

        // Taban/Tavan koruması (ItemData sınırlarına göre)
        return Mathf.Clamp(trueValue, item.template.minValue, item.template.maxValue * demandMultiplier);
    }

    // -------------------------------------------------------------
    // 2. ADIM: MÜŞTERİNİN KABUL EDECEĞİ EN DİP FİYAT (SÜBJEKTİF)
    // -------------------------------------------------------------
    /// <summary>
    /// Eşyanın gerçek değerini müşterinin karakteriyle harmanlar.
    /// "Hemen satan" dip fiyata razı olurken, "Tok satıcı" piyasa değerinin altına inmez.
    /// </summary>
    public static float CalculateCustomerFloorPrice(float trueMarketValue, CustomerTraits traits)
    {
        // 1. Aciliyet & Sıkışmışlık (Hemen Satma Baskısı)
        // Borç, aciliyet, nakit ihtiyacı ve çaresizlik fiyatı AŞAĞI çeker.
        float urgencyScore = (traits.urgency * 0.35f) + 
                             (traits.desperation * 0.30f) + 
                             (traits.needMoney * 0.20f) + 
                             (traits.debt * 0.15f); // 0 - 100 arası

        // 2. Tok Satıcılık & Direnç Faktörü
        // Gurur, açgözlülük, eşyaya duygusal bağ ve malın değerini bilme fiyatı YUKARI iter.
        float holdOutScore = (traits.pride * 0.35f) + 
                             (traits.greed * 0.30f) + 
                             (traits.itemAttachment * 0.20f) + 
                             (traits.itemKnowledge * 0.15f); // 0 - 100 arası

        // 3. İki tarafın psikolojik savaşı (-100 ile +100 arası net denge)
        float psychologicalBalance = holdOutScore - urgencyScore;

        // Çarpan Eğrisi:
        // En çaresiz/hemen satan (psychologicalBalance ≈ -100): Taban değerin %35'ine kadar düşer.
        // Dengeli / Normal müşteri (psychologicalBalance ≈ 0): Taban değerin %80-%85'inde durur.
        // Aşırı tok satıcı (psychologicalBalance ≈ +100): Piyasa değerinin %115'inden aşağı inmez!
        float customerMultiplier = 0.85f + (psychologicalBalance / 100f) * 0.40f;

        // Güvenlik sınırları: En ölücü bile %30'un altına düşmesin, en tok satıcı da %130'un üstüne çıkmasın
        customerMultiplier = Mathf.Clamp(customerMultiplier, 0.30f, 1.30f);

        return Mathf.Round(trueMarketValue * customerMultiplier);
    }

    // -------------------------------------------------------------
    // ÇARPAN MATRİS YARDIMCILARI
    // -------------------------------------------------------------
    private static float GetConditionMultiplier(ItemCondition condition)
    {
        switch (condition)
        {
            case ItemCondition.Broken: return 0.30f;
            case ItemCondition.Poor:   return 0.60f;
            case ItemCondition.Fair:   return 0.80f;
            case ItemCondition.Good:   return 1.00f;
            case ItemCondition.Mint:   return 1.25f;
            default: return 1.0f;
        }
    }

    private static float GetRarityMultiplier(ItemRarity rarity)
    {
        switch (rarity)
        {
            case ItemRarity.Common:    return 1.00f;
            case ItemRarity.Uncommon:  return 1.20f;
            case ItemRarity.Rare:      return 1.45f;
            case ItemRarity.Epic:      return 1.80f;
            case ItemRarity.Legendary: return 2.50f;
            default: return 1.0f;
        }
    }

    private static float GetAuthenticityMultiplier(ItemAuthenticity auth)
    {
        switch (auth)
        {
            case ItemAuthenticity.Authentic:   return 1.00f;
            case ItemAuthenticity.Stolen:       return 0.90f; // Sıcak mal, piyasa değeri korunur ama riskli
            case ItemAuthenticity.Counterfeit:  return 0.10f; // Sahteyse gerçek piyasa değeri neredeyse sıfırdır
            default: return 1.0f;
        }
    }

    private static float GetDemandMultiplier(MarketDemand demand)
    {
        switch (demand)
        {
            case MarketDemand.VeryLow:  return 0.60f;
            case MarketDemand.Low:      return 0.80f;
            case MarketDemand.Normal:   return 1.00f;
            case MarketDemand.High:     return 1.25f;
            case MarketDemand.Trending: return 1.50f;
            default: return 1.0f;
        }
    }
}


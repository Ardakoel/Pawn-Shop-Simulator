using UnityEngine;

public class PawnGameManager : MonoBehaviour
{
    public static PawnGameManager Instance { get; private set; }

    [Header("Oyuncu Durumu")]
    public float playerCash = 15000f; // Oyuncunun mevcut parası
    public int shopReputation = 50;   // Dükkanın itibarı (0 - 100)

    [Header("Mevcut Tezgâh Masası")]
    public CustomerData currentCustomer;
    public PawnShopItem currentItem;
    public MarketDemand currentMarketDemand = MarketDemand.Normal;

    private int customerStrikesLeft;
    private float currentAskingPrice;
    private float customerFloorPrice;
    private float trueMarketValue;

    private void Awake()
    {
        if (Instance == null) Instance = this;
        else Destroy(gameObject);
    }

    private void Start()
    {
        // Oyunu ilk müşteriyle başlat
        SpawnNextCustomer();
    }

    /// <summary>
    /// Tezgaha yeni bir müşteri ve rastgele durumdaki bir eşya getirir.
    /// </summary>
    public void SpawnNextCustomer()
    {
        // 1. Müşteriyi ve kişiliğini üret
        currentCustomer = CustomerPoolManager.Instance.GenerateRandomCustomer();

        // 2. Risk faktörlerine göre eşyanın yasallık durumunu hesapla
        ItemRiskReport risk = ItemRiskEvaluator.EvaluateItem(currentCustomer.traits);

        // 3. Örnek bir eşya şablonu oluştur (Projende Resources veya asset referansından gelir)
        ItemData template = ScriptableObject.CreateInstance<ItemData>();
        template.itemID = "ROLEX_SUB_01";
        template.itemName = "Rolex Submariner";
        template.category = ItemCategory.Watch;
        template.baseValue = 8000f;
        template.minValue = 1500f;
        template.maxValue = 12000f;
        template.rarity = ItemRarity.Rare;

        // Rastgele kondisyon
        ItemCondition randomCond = (ItemCondition)Random.Range(1, 5); // Poor ile Mint arası
        string serialNo = "SN-" + Random.Range(100000, 999999);

        // 4. Somut eşyayı oluştur
        currentItem = new PawnShopItem(template, randomCond, risk.legality, serialNo);

        // 5. Değer Matrisini ve Müşterinin Psikolojik Tabanını Hesapla
        trueMarketValue = ItemValuationSystem.CalculateTrueMarketValue(currentItem, currentMarketDemand);
        customerFloorPrice = ItemValuationSystem.CalculateCustomerFloorPrice(trueMarketValue, currentCustomer.traits);

        // Sabır vuruş hakkı
        customerStrikesLeft = Mathf.Clamp(currentCustomer.traits.patience / 20, 1, 5);

        // Açılış fiyatı (Açgözlülük oranında tabanın üstünden başlar)
        float markup = 1.15f + (currentCustomer.traits.greed * 0.003f);
        currentAskingPrice = Mathf.Round(trueMarketValue * markup);

        // Diyalog
        string greeting = CustomerDialogueDatabase.GetEntryGreeting(currentCustomer.traits, currentItem.customName);

        Debug.Log("==================================================");
        Debug.Log($"<color=cyan>[YENİ MÜŞTERİ]:</color> {currentCustomer.fullName} ({currentCustomer.patienceType})");
        Debug.Log($"<color=white>[DİYALOG]:</color> \"{greeting}\"");
        Debug.Log($"İstediği Fiyat: {currentAskingPrice:N0}$");
        Debug.Log($"<color=grey>[GİZLİ GÖZLEMCİ]: Gerçek Değer: {trueMarketValue:N0}$ | Müşterinin İneneceği Dip: {customerFloorPrice:N0}$</color>");
        Debug.Log("==================================================");
    }

    /// <summary>
    /// Oyuncu teklif verdiğinde çalışır.
    /// </summary>
    public void MakeOffer(float offer)
    {
        if (offer > playerCash)
        {
            Debug.Log("<color=red>Kasanızda bu kadar nakit yok!</color>");
            return;
        }

        // 1. Teklif taban fiyatı karşılıyor mu?
        if (offer >= customerFloorPrice)
        {
            CompletePurchase(offer);
            return;
        }

        // 2. Hakaret kontrolü (Kibirli müşteri ölü fiyata tahammül etmez)
        float ratio = offer / customerFloorPrice;
        if (ratio < 0.50f && currentCustomer.traits.pride > 65)
        {
            Debug.Log($"<color=red>[{currentCustomer.fullName}]:</color> 'Sen benim aklımla dalga mı geçiyorsun?!' Masayı terk etti.");
            CloseSession();
            return;
        }

        // 3. Sabır tüketimi ve karşı teklif
        customerStrikesLeft--;
        if (customerStrikesLeft <= 0)
        {
            Debug.Log($"<color=orange>[{currentCustomer.fullName}]:</color> 'Vaktimi çaldın. Anlaşamayacağız.' Çekip gitti.");
            CloseSession();
            return;
        }

        // Karşı teklif: Müşteri fiyatı biraz kırar
        float stepDiscount = (100 - currentCustomer.traits.hagglingSkill) * 0.0015f + 0.04f;
        currentAskingPrice = Mathf.Max(customerFloorPrice, Mathf.Round(currentAskingPrice * (1f - stepDiscount)));

        Debug.Log($"<color=yellow>[{currentCustomer.fullName}]:</color> 'Teklifin çok düşük. En son {currentAskingPrice:N0}$ yaparım.' (Kalan Sabır: {customerStrikesLeft})");
    }

    /// <summary>
    /// Satın alma işlemi gerçekleştiğinde çağrılır.
    /// </summary>
    private void CompletePurchase(float agreedPrice)
    {
        playerCash -= agreedPrice;
        Debug.Log($"<color=green>[ANLAŞMA SAĞLANDI]:</color> {currentItem.customName} {agreedPrice:N0}$ karşılığında satın alındı!");

        // Çalıntı mal aldıysa itibar veya polis riski
        if (currentItem.authenticity == ItemAuthenticity.Stolen)
        {
            shopReputation -= 15;
            Debug.Log("<color=red>[RİSK]:</color> Çalıntı bir eşya aldınız! Dükkanın itibarı zedelendi.");
        }
        else if (currentItem.authenticity == ItemAuthenticity.Counterfeit)
        {
            Debug.Log("<color=orange>[ZARAR]:</color> Sahte bir ürün aldınız, elinizde patlayabilir!");
        }
        else
        {
            shopReputation += 2;
        }

        CloseSession();
    }

    private void CloseSession()
    {
        Debug.Log($"Kalan Nakit: {playerCash:N0}$ | Dükkan İtibarı: {shopReputation}");
        Debug.Log("--- Sıradaki müşteriyi çağırmak için SpawnNextCustomer() çalıştırabilirsiniz. ---");
    }
}


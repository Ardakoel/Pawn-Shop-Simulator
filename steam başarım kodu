public class SteamAchievementManager : MonoBehaviour
{
    public static SteamAchievementManager Instance { get; private set; }

    private HashSet<string> unlockedAchievements = new HashSet<string>();

    private void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else
        {
            Destroy(gameObject);
        }
    }

    private void Start()
    {
#if !DISABLESTEAMWORKS
        if (!SteamManager.Initialized)
        {
            Debug.LogWarning("[STEAM]: Steam Manager başlatılamadı. Başarımlar yerel olarak çalışacak.");
            return;
        }
#endif
    }

    /// <summary>
    /// Verilen başarım kodunun kilidini açar.
    /// </summary>
    public void UnlockAchievement(AchievementType achievement)
    {
        string achievementID = GetAchievementKey(achievement);

        if (unlockedAchievements.Contains(achievementID)) return;

        unlockedAchievements.Add(achievementID);
        Debug.Log($"<color=green>[SUCCESS ACHIEVEMENT]:</color> {achievementID} kilidi açıldı!");

#if !DISABLESTEAMWORKS
        if (SteamManager.Initialized)
        {
            SteamUserStats.SetAchievement(achievementID);
            SteamUserStats.StoreStats(); // Steam sunucusuna bildir
        }
#endif
    }

    /// <summary>
    /// Alım satım işlemlerinde kâr ve indirim oranına göre başarımları tetikler.
    /// </summary>
    public void OnItemPurchased(float actualValue, float paidPrice, bool isStolen, bool isFake)
    {
        float discountRatio = (actualValue - paidPrice) / actualValue;

        // %50 ve üzeri indirim
        if (discountRatio >= 0.50f && discountRatio < 0.75f)
        {
            UnlockAchievement(AchievementType.GoodDeal);
        }
        // %75 ve üzeri indirim
        else if (discountRatio >= 0.75f && discountRatio < 0.85f)
        {
            UnlockAchievement(AchievementType.MasterTrader);
        }
        // %85 ve üzeri soygun gibi indirim
        else if (discountRatio >= 0.85f)
        {
            UnlockAchievement(AchievementType.HighwayRobbery);
        }

        // Çalıntı mal başarımı
        if (isStolen)
        {
            UnlockAchievement(AchievementType.StolenGoods);
        }

        // Sahte mala kanma
        if (isFake && paidPrice >= actualValue)
        {
            UnlockAchievement(AchievementType.Scammed);
        }

        // Zararına alış (Hayırsever)
        if (paidPrice > actualValue * 1.20f)
        {
            UnlockAchievement(AchievementType.CharityWork);
        }
    }

    private string GetAchievementKey(AchievementType type)
    {
        switch (type)
        {
            case AchievementType.FirstDayDone: return "ACH_DAY_1";
            case AchievementType.GoodDeal: return "ACH_TRADER";
            case AchievementType.MasterTrader: return "ACH_MASTER_TRADER";
            case AchievementType.FirstProfit: return "ACH_WORK";
            case AchievementType.StolenGoods: return "ACH_STOLEN_GOODS";
            default: return "ACH_" + type.ToString().ToUpper();
        }
    }
}


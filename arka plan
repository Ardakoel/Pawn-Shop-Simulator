public enum TransactionType
{
    PurchaseFromCustomer, // Müşteriden eşya alımı (Gider)
    SaleToBuyer,          // Vitrinden alıcıya satış (Gelir)
    AuctionSale,          // Müzayede satışı
    PoliceConfiscation,   // Polisin el koyması (Zarar)
    DiscardLoss           // Çöpe atma / İmha (Zarar)
}

[System.Serializable]
public class TransactionRecord
{
    [Header("Temel Bilgiler")]
    public string transactionID;     // Benzersiz Fiş No (GUID)
    public TransactionType type;
    public string customerName;      // Müşterinin tam adı
    public string itemName;          // Eşya adı
    public string itemUniqueID;      // Eşyanın envanterdeki GUID'si
    public ItemCategory category;

    [Header("Finansal Kalemler")]
    public float transactionAmount;  // Kasadan çıkan veya kasaya giren nakit
    public float realMarketValue;    // Eşyanın gerçek piyasa/ekspertiz değeri
    public float netProfit;          // Bu işlemden elde edilen anlık/potansiyel net kâr

    [Header("Durum & Zaman")]
    public AuthenticityType authenticity; // Eşyanın gerçek orijinallik durumu
    public string inGameDate;             // Örn: "Day 14 - 15:45"
    public long timestampTicks;           // Sıralama için zaman damgası

    public TransactionRecord(
        TransactionType tType,
        string customer,
        string item,
        string itemUID,
        ItemCategory cat,
        float amount,
        float realValue,
        float profit,
        AuthenticityType auth,
        string date)
    {
        transactionID = Guid.NewGuid().ToString().Substring(0, 8).ToUpper();
        type = tType;
        customerName = customer;
        itemName = item;
        itemUniqueID = itemUID;
        category = cat;
        transactionAmount = amount;
        realMarketValue = realValue;
        netProfit = profit;
        authenticity = auth;
        inGameDate = date;
        timestampTicks = DateTime.UtcNow.Ticks;
    }
}


public enum DayPhase
{
    MorningBriefing, // Sabah: Gazete manşeti okunur, piyasa trendleri ve hava durumu görülür
    ShopOpen,        // Mesai: Müşteriler tezgaha gelir, pazarlıklar ve ekspertizler yapılır
    EveningLedger,   // Akşam Kasa Kapatma: Günlük gelir/gider tablosu ve istatistik özeti
    NightSimulation  // Gece / Ekonomi: Sabit dükkan kirası/faturalar kesilir, çalıntı mal ısısı artar
}

using System;
using System.Collections;
using UnityEngine;

public class DaySystem : MonoBehaviour
{
    public static DaySystem Instance { get; private set; }

    [Header("Zaman Ayarları")]
    public int currentDay = 1;
    public DayPhase currentPhase = DayPhase.MorningBriefing;

    [Header("Günlük Sabit Giderler")]
    public float dailyShopRent = 150f;      // Dükkan günlük kirası
    public float dailyUtilities = 50f;      // Elektrik, su, alarm faturası

    // Olay Bildirimleri (UI panellerini tetiklemek için)
    public event Action<int, DayPhase> OnPhaseChanged;
    public event Action<int> OnNewDayStarted;

    private void Awake()
    {
        if (Instance == null) Instance = this;
        else Destroy(gameObject);
    }

    private void Start()
    {
        // Oyunu 1. Günün Sabahıyla Başlat
        StartCoroutine(ExecuteDayCycle(currentDay));
    }

    /// <summary>
    /// Günün 4 evresini sırasıyla işleten ana döngü.
    /// </summary>
    public void AdvancePhase()
    {
        switch (currentPhase)
        {
            case DayPhase.MorningBriefing:
                // Sabah bülteni bitti, kepenkleri aç
                SetPhase(DayPhase.ShopOpen);
                break;

            case DayPhase.ShopOpen:
                // Gelen son müşteri de gitti, kasayı kapat
                SetPhase(DayPhase.EveningLedger);
                break;

            case DayPhase.EveningLedger:
                // Oyuncu hesap özetini onayladı, gece simülasyonunu çalıştır
                SetPhase(DayPhase.NightSimulation);
                break;

            case DayPhase.NightSimulation:
                // Yeni güne geç
                currentDay++;
                StartCoroutine(ExecuteDayCycle(currentDay));
                break;
        }
    }

    private void SetPhase(DayPhase newPhase)
    {
        currentPhase = newPhase;
        Debug.Log($"<color=yellow>⏰ [FAZ DEĞİŞTİ]:</color> Gün {currentDay} -> <b>{currentPhase}</b>");
        OnPhaseChanged?.Invoke(currentDay, currentPhase);

        // Gece fazına geçildiyse arka plan hesaplarını yapıp doğrudan yeni güne bağla
        if (currentPhase == DayPhase.NightSimulation)
        {
            ProcessNightCalculations();
            AdvancePhase(); // Yeni sabahı başlat
        }
    }

    // -----------------------------------------------------------------
    // GÜNÜN EVRE İŞLEMLERİ (SYSTEM ORCHESTRATION)
    // -----------------------------------------------------------------

    private IEnumerator ExecuteDayCycle(int day)
    {
        yield return null;

        currentPhase = DayPhase.MorningBriefing;
        Debug.Log($"<color=cyan>══════════════════ 🌅 GÜN {day} BAŞLADI 🌅 ══════════════════</color>");
        OnNewDayStarted?.Invoke(day);

        // 1. SABAH: Piyasa, Gazete ve Rastgele Olayları Güncelle
        if (MarketSystem.Instance != null) MarketSystem.Instance.AdvanceToNextDay();
        if (NewsSystem.Instance != null) NewsSystem.Instance.PublishMorningNews(day);
        if (RandomEventSystem.Instance != null) RandomEventSystem.Instance.CheckForDailyEvent(day);
        if (PoliceSystem.Instance != null) PoliceSystem.Instance.EvaluateDailyPoliceVisit(day);

        OnPhaseChanged?.Invoke(day, currentPhase);
    }

    /// <summary>
    /// Dükkan kepenkleri açıldığında müşteri akışını başlatır.
    /// </summary>
    public void OpenShopForCustomers()
    {
        if (currentPhase != DayPhase.MorningBriefing) return;
        AdvancePhase(); // ShopOpen fazına geçer
        
        // Müşteri havuzu bugünkü kuyruğu oluşturur (İtibara göre müşteri sayısı)
        int customerQuota = ReputationSystem.Instance != null 
            ? ReputationSystem.Instance.GetDailyCustomerCount() 
            : 5;

        Debug.Log($"<color=green>[KEPENKLER AÇILDI]:</color> Bugün dükkana {customerQuota} müşteri uğrayacak.");
    }

    /// <summary>
    /// Gece dükkan kapalıyken arka planda dönen ekonomi ve risk hesapları.
    /// </summary>
    private void ProcessNightCalculations()
    {
        Debug.Log("<color=grey>[GECE HESAPLARI]: Sabit giderler ve adli riskler işletiliyor...</color>");

        // 1. Sabit Giderleri Kasadan Düş (Kira + Fatura)
        float totalBills = dailyShopRent + dailyUtilities;
        PawnGameManager.Instance.playerCash -= totalBills;
        Debug.Log($"Kira ve faturalar ödendi: -${totalBills:N0} (Kalan Nakit: ${PawnGameManager.Instance.playerCash:N0})");

        // 2. Çalıntı Eşya Polis Isısını Artır
        if (StolenItemSystem.Instance != null)
        {
            StolenItemSystem.Instance.ProcessDailyStolenHeat();
        }

        // 3. İflas Kontrolü
        if (PawnGameManager.Instance.playerCash < -1000f)
        {
            Debug.LogError("<color=red>💀 [İFLAS]: Dükkan borçlarını ödeyemedi ve mühürlendi! GAME OVER.</color>");
        }
    }
}


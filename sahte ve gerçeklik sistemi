public enum AuthenticityType
{
    Authentic,  // %100 Orijinal, fabrikasyon/sanatçı çıkışlı
    Fake,       // Tamamen sahte, ucuz taklit
    Replica,    // Birebir kopyalanmış, yüksek kaliteli replika (fark etmesi zordur)
    Modified,   // Franken/Hibrit: Bazı parçaları orijinal, bazıları sonradan takılma/sahte
    Stolen,     // Orijinal ama çalıntı (Polis ve yasal risk taşır)
    Damaged,    // Orijinal fakat gizli ağır yapısal kusuru var (su almış mekanizma, çatlak tuval)
    Restored,   // Orijinal ama profesyonel olmayan şekilde restore edilmiş (koleksiyon değerini kırar)
    Unknown     // Henüz ekspertiz yapılmamış, durumu belirsiz
}

public static class AuthenticityExtensions
{
    /// <summary>
    /// Orijinallik durumunun eşyanın gerçek değerine olan etkisi.
    /// </summary>
    public static float GetValueMultiplier(this AuthenticityType type)
    {
        switch (type)
        {
            case AuthenticityType.Authentic: return 1.0f;
            case AuthenticityType.Restored:   return 0.70f; // Restorasyon koleksiyon değerini düşürür
            case AuthenticityType.Stolen:     return 0.85f; // Mal orijinaldir ama kara borsa risk primi yer
            case AuthenticityType.Modified:   return 0.40f; // Franken eşyalar ciddi değer kaybeder
            case AuthenticityType.Damaged:    return 0.30f; // Ağır hasarlı
            case AuthenticityType.Replica:    return 0.15f; // Kaliteli de olsa replika
            case AuthenticityType.Fake:       return 0.05f; // Neredeyse değersiz
            case AuthenticityType.Unknown:    return 1.0f;
            default: return 1.0f;
        }
    }
}

using UnityEngine;

[System.Serializable]
public class ItemComponentPart
{
    public string partName;             // Örn: "Kasa", "İç Mekanizma", "İmza", "Tuval/Kağıt", "Çerçeve"
    public AuthenticityType realStatus; // Gerçekte ne olduğu (Gizli)
    public bool isInspected;            // Oyuncu bu parçayı inceledi mi?

    [TextArea(2, 3)]
    public string flawDescription;      // Kusur varsa açıklaması (Örn: "Mekanizma üzerindeki dişliler pirinç değil, ucuz alaşım.")

    public ItemComponentPart(string name, AuthenticityType status, string flaw = "")
    {
        partName = name;
        realStatus = status;
        isInspected = false;
        flawDescription = flaw;
    }
}

using System.Collections.Generic;
using UnityEngine;

public static class AuthenticitySystem
{
    /// <summary>
    /// Parçaların durumuna bakarak eşyanın genel (Overall) orijinallik statüsünü belirler.
    /// </summary>
    public static AuthenticityType DetermineOverallAuthenticity(List<ItemComponentPart> parts, bool isStolen)
    {
        if (isStolen) return AuthenticityType.Stolen;

        int fakeCount = 0;
        int authenticCount = 0;
        int modifiedCount = 0;
        int restoredCount = 0;

        foreach (var part in parts)
        {
            if (part.realStatus == AuthenticityType.Fake || part.realStatus == AuthenticityType.Replica)
                fakeCount++;
            else if (part.realStatus == AuthenticityType.Authentic)
                authenticCount++;
            else if (part.realStatus == AuthenticityType.Modified)
                modifiedCount++;
            else if (part.realStatus == AuthenticityType.Restored)
                restoredCount++;
        }

        // Hepsi sahteyse -> Fake
        if (fakeCount == parts.Count) return AuthenticityType.Fake;

        // Bazıları orijinal bazıları sahteyse (Örn: Rolex kasası orijinal, mekanizma sahte) -> Modified (Franken)
        if (fakeCount > 0 && authenticCount > 0) return AuthenticityType.Modified;

        // Sadece amatör onarım/restorasyon varsa -> Restored
        if (restoredCount > 0 && fakeCount == 0) return AuthenticityType.Restored;

        // Hepsi temizse -> Authentic
        if (authenticCount == parts.Count) return AuthenticityType.Authentic;

        return AuthenticityType.Replica;
    }

    /// <summary>
    /// Oyuncu bir parçayı özel bir ekspertiz aracıyla incelediğinde çalışır.
    /// </summary>
    public static InspectionReport InspectSpecificPart(ItemComponentPart part, InspectionToolType tool)
    {
        part.isInspected = true;
        InspectionReport report = new InspectionReport();

        if (part.realStatus == AuthenticityType.Authentic)
        {
            report.success = true;
            report.detectedStatus = AuthenticityType.Authentic;
            report.feedback = $"[{part.partName}]: İnceleme kusursuz. Malzeme kalitesi, damgalar ve işçilik orijinal standartlarda.";
        }
        else
        {
            report.success = true;
            report.detectedStatus = part.realStatus;
            report.feedback = $"<color=red>[KUSUR TESPİT EDİLDİ - {part.partName}]:</color> {part.flawDescription}";
        }

        return report;
    }
}

public struct InspectionReport
{
    public bool success;
    public AuthenticityType detectedStatus;
    public string feedback;
}


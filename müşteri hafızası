using System;
using UnityEngine;

public enum DealOutcomeHistory
{
    None,             // İlk kez geliyor, geçmiş yok
    SuccessfulDeal,   // Geçen sefer anlaşıldı (Mutlu ayrıldı)
    InsultedLowball,  // Çok düşük teklifle gururu kırıldı / kazıklanmaya çalışıldı
    WalkedAwayPatience,// Sabrı bittiği için anlaşamadan gitti
    CaughtCounterfeit // Sahtekarlık yaparken yakalandı / yüzleşildi
}

[System.Serializable]
public class CustomerMemoryRecord
{
    public string customerFullName;       // Müşterinin tam adı (Örn: "Mateo Rodriguez")
    public int visitCount = 0;             // Kaçıncı gelişi?
    
    [Header("Son Ziyaret Detayları")]
    public string lastItemName;            // Geçen getirdiği eşya (Örn: "Rolex Submariner")
    public float lastPlayerOffer;          // Oyuncunun verdiği son teklif
    public float lastAgreedPrice;          // Eğer satıldıysa anlaşılan fiyat
    public DealOutcomeHistory lastOutcome; // Nasıl ayrıldı?
    
    [Header("Oyuncuya Olan Özel Güven (0 - 100)")]
    [Range(0, 100)] public float personalTrust = 50f;

    public CustomerMemoryRecord(string name)
    {
        customerFullName = name;
        visitCount = 1;
        personalTrust = 50f;
        lastOutcome = DealOutcomeHistory.None;
    }
}

using System;
using System.Collections.Generic;
using UnityEngine;

public class CustomerMemorySystem : MonoBehaviour
{
    public static CustomerMemorySystem Instance { get; private set; }

    // Tüm müşterilerin hafıza arşivi (İsim bazlı arama)
    [SerializeField] 
    private List<CustomerMemoryRecord> memoryDatabase = new List<CustomerMemoryRecord>();

    private void Awake()
    {
        if (Instance == null) Instance = this;
        else Destroy(gameObject);
    }

    /// <summary>
    /// Kapıdan giren müşterinin hafıza kaydını çeker; ilk defa geliyorsa yeni dosya açar.
    /// </summary>
    public CustomerMemoryRecord RetrieveOrCreateMemory(string customerName)
    {
        CustomerMemoryRecord record = memoryDatabase.Find(r => r.customerFullName.Equals(customerName, StringComparison.OrdinalIgnoreCase));

        if (record == null)
        {
            record = new CustomerMemoryRecord(customerName);
            memoryDatabase.Add(record);
        }
        else
        {
            record.visitCount++;
        }

        return record;
    }

    /// <summary>
    /// Masadaki pazarlık bittiğinde (anlaşma sağlandı, müşteri gitti vs.) hafızayı günceller.
    /// </summary>
    public void UpdateMemoryAfterDeal(
        string customerName, 
        string itemName, 
        float playerOffer, 
        float finalPrice, 
        DealOutcomeHistory outcome)
    {
        CustomerMemoryRecord record = RetrieveOrCreateMemory(customerName);
        record.lastItemName = itemName;
        record.lastPlayerOffer = playerOffer;
        record.lastAgreedPrice = finalPrice;
        record.lastOutcome = outcome;

        // Güven puanı güncellemesi
        switch (outcome)
        {
            case DealOutcomeHistory.SuccessfulDeal:
                record.personalTrust = Mathf.Clamp(record.personalTrust + 15f, 0f, 100f);
                break;

            case DealOutcomeHistory.InsultedLowball:
                record.personalTrust = Mathf.Clamp(record.personalTrust - 25f, 0f, 100f);
                break;

            case DealOutcomeHistory.WalkedAwayPatience:
                record.personalTrust = Mathf.Clamp(record.personalTrust - 10f, 0f, 100f);
                break;

            case DealOutcomeHistory.CaughtCounterfeit:
                record.personalTrust = Mathf.Clamp(record.personalTrust - 5f, 0f, 100f);
                break;
        }

        Debug.Log($"<color=magenta>[HAFIZA GÜNCELLENDİ]:</color> {customerName} | Ziyaret: {record.visitCount} | Sonuç: {outcome} | Güven: {record.personalTrust:F0}");
    }

    /// <summary>
    /// Müşterinin hafızasına göre tezgâha adım attığında söyleyeceği özel hatırlatma cümlesi.
    /// </summary>
    public string GenerateMemoryGreeting(CustomerMemoryRecord memory, CustomerTraits traits)
    {
        // 1. Ziyaret: İlk defa geliyor, hafıza repliği yok
        if (memory.visitCount <= 1 || memory.lastOutcome == DealOutcomeHistory.None)
        {
            return ""; // Standart DialogueGenerator selamlama cümlesi devreye girer
        }

        // 2. ve Sonraki Ziyaretler: Geçmişe göre özel replikler
        switch (memory.lastOutcome)
        {
            case DealOutcomeHistory.InsultedLowball:
                return $"Yine mi sen? Geçen sefer getirdiğim {memory.lastItemName} için bana komik bir ${memory.lastPlayerOffer:N0} teklif edip beni kazıklamaya çalışmıştın! Bu sefer yemez, aklını başına devir.";

            case DealOutcomeHistory.SuccessfulDeal:
                return $"Selam usta! Geçen sefer {memory.lastItemName} konusunda çok dürüst ve yardımcı olmuştun. Elimde yine temiz bir parça var, ilk sana getirdim.";

            case DealOutcomeHistory.WalkedAwayPatience:
                return $"Umarım bu sefer çene çalmak yerine ciddi bir teklif verirsin. Geçen gelişimde bütün vaktimi boşa harcamıştın.";

            case DealOutcomeHistory.CaughtCounterfeit:
                return $"(Gözlerini kaçırarak) Şey... Selam. Geçen seferki saat mevzusunu unutalım, bu sefer getirdiğim parçanın orijinal olduğuna yemin edebilirim...";

            default:
                return $"Tekrar karşılaştık esnaf. Bakalım bu sefer anlaşabilecek miyiz?";
        }
    }

    /// <summary>
    /// Geçmiş deneyimin müşterinin bugünkü sabrına ve fiyat inadına etkisi.
    /// </summary>
    public void ApplyMemoryModifiersToTraits(CustomerMemoryRecord memory, CustomerTraits traits)
    {
        if (memory.visitCount <= 1) return;

        if (memory.lastOutcome == DealOutcomeHistory.InsultedLowball)
        {
            // Geçen sefer ezildiyse sabrı %30 daha az başlar, gururu artar!
            traits.patience = Mathf.RoundToInt(traits.patience * 0.70f);
            traits.pride = Mathf.Clamp(traits.pride + 15, 0, 100);
            Debug.Log("<color=orange>[HAFIZA ETKİSİ]:</color> Müşteri geçen seferden kinli! Sabrı düşük, gururu yüksek başladı.");
        }
        else if (memory.lastOutcome == DealOutcomeHistory.SuccessfulDeal)
        {
            // Geçen sefer memnun ayrıldıysa daha sabırlı ve toleranslıdır
            traits.patience = Mathf.Clamp(traits.patience + 15, 0, 100);
            traits.hagglingSkill = Mathf.RoundToInt(traits.hagglingSkill * 0.90f); // Bize güvendiği için daha az direnir
            Debug.Log("<color=green>[HAFIZA ETKİSİ]:</color> Müşteri eski dost! Daha sabırlı ve esnek pazarlık yapacak.");
        }
    }
}


public enum RelationshipTier
{
    Nemesis,     // Düşman / Nefret Eden (-100 ile -51): Kazıklanmış, kin güdüyor
    Distrustful, // Şüpheci / Soğuk (-50 ile -16): Geçmişte gerginlik yaşamış
    Neutral,     // Nötr (-15 ile +15): Sıradan müşteri
    Friendly,    // Dost / Sempatik (+16 ile +50): Birkaç kez adil ticaret yapmış
    LoyalPartner // Sadık Müdavim (+51 ile +100): Dükkânın daimi müşterisi
}

using System;
using System.Collections.Generic;
using UnityEngine;

[System.Serializable]
public class CustomerRelationshipProfile
{
    public string customerName;
    [Range(-100f, 100f)] public float affinityScore = 0f; // -100 (Nefret) ... 0 (Nötr) ... +100 (Kör Güven)
    public RelationshipTier currentTier = RelationshipTier.Neutral;
    public int totalSuccessfulDeals = 0;
    public int totalFailedDeals = 0;

    public CustomerRelationshipProfile(string name)
    {
        customerName = name;
        affinityScore = 0f;
        currentTier = RelationshipTier.Neutral;
    }

    public void UpdateAffinity(float delta)
    {
        affinityScore = Mathf.Clamp(affinityScore + delta, -100f, 100f);
        UpdateTier();
    }

    private void UpdateTier()
    {
        if (affinityScore <= -51f) currentTier = RelationshipTier.Nemesis;
        else if (affinityScore <= -16f) currentTier = RelationshipTier.Distrustful;
        else if (affinityScore <= 15f) currentTier = RelationshipTier.Neutral;
        else if (affinityScore <= 50f) currentTier = RelationshipTier.Friendly;
        else currentTier = RelationshipTier.LoyalPartner;
    }
}

public class CustomerRelationshipSystem : MonoBehaviour
{
    public static CustomerRelationshipSystem Instance { get; private set; }

    [SerializeField]
    private List<CustomerRelationshipProfile> profiles = new List<CustomerRelationshipProfile>();

    private void Awake()
    {
        if (Instance == null) Instance = this;
        else Destroy(gameObject);
    }

    /// <summary>
    /// Müşterinin kalıcı ilişki profilini getirir, yoksa yeni açar.
    /// </summary>
    public CustomerRelationshipProfile GetOrCreateProfile(string customerName)
    {
        var profile = profiles.Find(p => p.customerName.Equals(customerName, StringComparison.OrdinalIgnoreCase));
        if (profile == null)
        {
            profile = new CustomerRelationshipProfile(customerName);
            profiles.Add(profile);
        }
        return profile;
    }

    // -------------------------------------------------------------------------
    // TİCARET SONUÇLARINA GÖRE İLİŞKİ PUANI GÜNCELLEME
    // -------------------------------------------------------------------------

    /// <summary>
    /// Başarılı bir alışveriş sonrası çağrılır.
    /// </summary>
    public void RecordTradeSuccess(string customerName, bool wasGenerousOffer)
    {
        var profile = GetOrCreateProfile(customerName);
        profile.totalSuccessfulDeals++;

        // Oyuncu cömert ve adil davrandıysa güven hızla tırmanır
        float gain = wasGenerousOffer ? 20f : 10f;
        profile.UpdateAffinity(gain);

        Debug.Log($"<color=green>[İLİŞKİ ARTTI]:</color> {customerName} -> Puan: {profile.affinityScore:F0} ({profile.currentTier})");
    }

    /// <summary>
    /// Hakaret düzeyinde düşük teklif veya gergin ayrılık sonrası çağrılır.
    /// </summary>
    public void RecordTradeInsult(string customerName, bool caughtScamming = false)
    {
        var profile = GetOrCreateProfile(customerName);
        profile.totalFailedDeals++;

        // Kazıklanmaya çalışıldıysa sert nefret kazanır
        float penalty = caughtScamming ? -15f : -25f;
        profile.UpdateAffinity(penalty);

        Debug.Log($"<color=red>[İLİŞKİ DÜŞTÜ]:</color> {customerName} -> Puan: {profile.affinityScore:F0} ({profile.currentTier})");
    }

    // -------------------------------------------------------------------------
    // PAZARLIK VE DAVRANIŞ MODİFİYERLERİ (CORE LOOP ETKİSİ)
    // -------------------------------------------------------------------------

    /// <summary>
    /// Müşterinin açılış fiyatını ilişkisine göre ayarlar.
    /// Nefret eden adam fiyatı şişirir; sadık müşteri adil başlar.
    /// </summary>
    public float ModifyStartingPrice(string customerName, float baseStartingPrice)
    {
        var profile = GetOrCreateProfile(customerName);

        switch (profile.currentTier)
        {
            case RelationshipTier.Nemesis:
                // Senden nefret ettiği için %30 kazık fiyatla açar
                return Mathf.Round(baseStartingPrice * 1.30f);

            case RelationshipTier.Distrustful:
                return Mathf.Round(baseStartingPrice * 1.15f);

            case RelationshipTier.Friendly:
                // Bizi sevdiği için açılışı şişirmez
                return Mathf.Round(baseStartingPrice * 0.95f);

            case RelationshipTier.LoyalPartner:
                // Sadık dost: Direkt makul piyasa fiyatından açar (%10 indirimli)
                return Mathf.Round(baseStartingPrice * 0.90f);

            default:
                return baseStartingPrice;
        }
    }

    /// <summary>
    /// Müşterinin inebileceği en dip fiyat sınırını (Floor Price) esnetir.
    /// </summary>
    public float ModifyMinimumFloorPrice(string customerName, float baseFloorPrice)
    {
        var profile = GetOrCreateProfile(customerName);

        switch (profile.currentTier)
        {
            case RelationshipTier.Nemesis:
                // Nefret eden müşteri tabanından 1 dolar bile ödün vermez
                return Mathf.Round(baseFloorPrice * 1.10f);

            case RelationshipTier.LoyalPartner:
                // Sana güvenen dost, dip fiyatın da %8 altına inmeye razı olur
                return Mathf.Round(baseFloorPrice * 0.92f);

            default:
                return baseFloorPrice;
        }
    }

    /// <summary>
    /// Sabır puanına ilişki bonusu veya cezası ekler.
    /// </summary>
    public int ModifyPatience(string customerName, int basePatience)
    {
        var profile = GetOrCreateProfile(customerName);

        switch (profile.currentTier)
        {
            case RelationshipTier.Nemesis:
                // Düşman müşteri 1-2 kötü teklifte anında patlar (-35 sabır)
                return Mathf.Max(15, basePatience - 35);

            case RelationshipTier.Distrustful:
                return Mathf.Max(20, basePatience - 15);

            case RelationshipTier.Friendly:
                return Mathf.Min(100, basePatience + 15);

            case RelationshipTier.LoyalPartner:
                // Sadık müşteri seni kırmaz, saatlerce pazarlık yapabilir (+30 sabır)
                return Mathf.Min(100, basePatience + 30);

            default:
                return basePatience;
        }
    }

    /// <summary>
    /// Müşterinin ilişki seviyesine göre tezgâha koyduğu tavır cümlesi.
    /// </summary>
    public string GetRelationshipDialogue(string customerName)
    {
        var profile = GetOrCreateProfile(customerName);

        switch (profile.currentTier)
        {
            case RelationshipTier.Nemesis:
                return "Mecbur kalmasam dükkânının önünden bile geçmezdim. Mal bu, fiyat bu! Tek kuruş aşağı inmem, zoruna gidiyorsa kapı orada.";

            case RelationshipTier.Distrustful:
                return "Gözüm üzerinde esnaf... Geçen seferki gibi beni ezmeye çalışırsan hiç uzatmadan çeker giderim.";

            case RelationshipTier.Friendly:
                return "Tekrar selam dostum! Seninle çalışmayı seviyorum, dürüst adamsın. Bakalım buna ne diyeceksin?";

            case RelationshipTier.LoyalPartner:
                return "Kardeşim selamlar! Elimdeki en değerli parçayı doğrudan sana getirdim. Başkasına götürmedim bile, biliyorum ki hakkını verirsin.";

            default:
                return "İyi günler, elimdeki bu eşyayı değerlendirmek istiyorum.";
        }
    }
}


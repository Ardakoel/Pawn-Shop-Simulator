using System;
using UnityEngine;

public enum Gender
{
    Male,
    Female
}

public enum PatienceType
{
    Impatient, // Sabırsız: Ters bir teklifte anında masadan kalkar, toleransı çok dar
    Moderate,  // Orta: Birkaç karşı teklife dayanır, mantıklı pazarlık yapar
    Patient    // Sabırlı: Çoklu tekliflere açık, esnek tolerans aralığı var
}

[System.Serializable]
public class CustomerData
{
    public string fullName;
    public Gender gender;
    public PatienceType patienceType;

    // Sabır / Dayanıklılık Değerleri
    public int maxPatienceStrikes; // Kaç kötü teklife dayanabilir
    public int currentPatienceStrikes;

    // Fiyat toleransı (Örn: Sabırlı %25 esnerken, sabırsız %5 esner)
    public float priceToleranceRatio;

    public CustomerData(string name, Gender gen, PatienceType patience)
    {
        fullName = name;
        gender = gen;
        patienceType = patience;

        // Sabır tipine göre değişkenleri ayarla
        switch (patienceType)
        {
            case PatienceType.Impatient:
                maxPatienceStrikes = 1;         // Tek bir kötü teklifte çeker gider
                priceToleranceRatio = 0.05f;    // En fazla %5 indirim/artış kabul eder
                break;

            case PatienceType.Moderate:
                maxPatienceStrikes = 3;         // 2-3 tur pazarlık yapar
                priceToleranceRatio = 0.15f;    // %15 esneme payı
                break;

            case PatienceType.Patient:
                maxPatienceStrikes = 5;         // 5 tura kadar dayanır
                priceToleranceRatio = 0.25f;    // %25 esneme payı
                break;
        }

        currentPatienceStrikes = maxPatienceStrikes;
    }

    /// <summary>
    /// Oyuncunun sunduğu teklifi müşterinin sabır ve toleransına göre değerlendirir.
    /// </summary>
    /// <param name="offeredPrice">Oyuncunun istediği / teklif ettiği fiyat</param>
    /// <param name="basePrice">Ürünün/hizmetin liste fiyatı</param>
    /// <returns>Teklif kabul edildi mi, pazarlık sürüyor mu, yoksa müşteri gitti mi?</returns>
    public NegotiationResult EvaluateOffer(float offeredPrice, float basePrice)
    {
        // Kabul edilebilir tavan fiyat
        float acceptableMaxPrice = basePrice * (1f + priceToleranceRatio);

        // Teklif makul sınırlar içindeyse kabul et
        if (offeredPrice <= acceptableMaxPrice)
        {
            return NegotiationResult.Accepted;
        }

        // Teklif çok yüksek/kötü -> Sabır tüket
        currentPatienceStrikes--;

        if (currentPatienceStrikes <= 0)
        {
            return NegotiationResult.WalkedAway; // Sabır bitti, dükkandan/masadan ayrıldı
        }

        return NegotiationResult.CounterOfferNeeded; // Hala sabrı var, pazarlık devam ediyor
    }
}

public enum NegotiationResult
{
    Accepted,
    CounterOfferNeeded,
    WalkedAway
}


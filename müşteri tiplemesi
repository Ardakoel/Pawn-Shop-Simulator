using UnityEngine;

public class ShopTest : MonoBehaviour
{
    private void Start()
    {
        // Yeni bir müşteri oluştur
        CustomerData customer = CustomerPoolManager.Instance.GenerateRandomCustomer();
        Debug.Log($"Müşteri Geldi: {customer.fullName} | Cinsiyet: {customer.gender} | Sabır Tipi: {customer.patienceType}");

        float baseItemPrice = 100f; // Ürünün gerçek fiyatı
        float myOffer = 130f;       // Bizim istediğimiz yüksek fiyat

        // Pazarlık teklifi yap
        NegotiationResult result = customer.EvaluateOffer(myOffer, baseItemPrice);

        switch (result)
        {
            case NegotiationResult.Accepted:
                Debug.Log($"{customer.fullName}: Fiyat bana uygun, anlaştık!");
                break;

            case NegotiationResult.CounterOfferNeeded:
                Debug.Log($"{customer.fullName}: Bu fiyat biraz fazla. Daha iyi bir teklifin var mı? (Kalan Sabır: {customer.currentPatienceStrikes})");
                break;

            case NegotiationResult.WalkedAway:
                Debug.Log($"{customer.fullName}: Bu fiyata asla almam, gidiyorum! (Dükkanı terk etti)");
                break;
        }
    }
}


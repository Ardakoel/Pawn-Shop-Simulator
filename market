                );

            case 7:
            default:
                return new NewsArticle(
                    "Lüks Replika Saat Skandalı: Pazar Güven Kaybetti!",
                    "Piyasadaki her 3 lüks saatten birinin modifiye sahte olduğu ortaya çıktı. Alıcılar eksper raporu olmadan adım atmıyor.",
                    ItemCategory.Watch,
                    NewsImpactType.PriceCrash,
                    -0.20f, // -%20
                    2
                );
        }
    }
}

public float GetMarketMultiplier(ItemCategory category)
{
    // Temel trend çarpanı
    MarketTrend trend = activeTrends.Find(t => t.category == category);
    float baseMultiplier = trend != null ? trend.CurrentMultiplier : 1.0f;

    // Haber sisteminden gelen sıcak manşet etkisi
    float newsMultiplier = NewsSystem.Instance != null 
        ? NewsSystem.Instance.GetCategoryNewsMultiplier(category) 
        : 1.0f;

    return baseMultiplier * newsMultiplier;
}

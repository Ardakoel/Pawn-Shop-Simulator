            case 0:
                return new NewsArticle(
                    "Ünlü Aktör Vintage Saat Koleksiyonunu Satışa Çıkarıyor!",
                    "Hollywood yıldızının retro saat tercihi New York sosyetesinde akım başlattı. Klasik ve vintage saatlere talep patladı.",
                    ItemCategory.Watch,
                    NewsImpactType.PriceBoost,
                    0.25f, // +%25
                    3
                );

            case 1:
                return new NewsArticle(
                    "Merkez Bankası'ndan Sürpriz Karar: Değerli Madenler Tırmanışta!",
                    "Enflasyon baskısıyla altına ve gümüşe hücum başladı. Kuyumcular ve rehin dükkanlarında külçe/takı fiyatları yükseliyor.",
                    ItemCategory.Jewelry,
                    NewsImpactType.PriceBoost,
                    0.30f, // +%30
                    2
                );

            case 2:
                return new NewsArticle(
                    "Büyük Dolandırıcılık Şebekesi Çökertildi: Piyasada Sahte Tablo Alarmı!",
                    "Metropolitan bölgesinde faaliyet gösteren bir sahte sanat atölyesi basıldı. Koleksiyonerler tablo alımlarını durdurdu.",
                    ItemCategory.Painting,
                    NewsImpactType.PriceCrash,
                    -0.25f, // -%25
                    2
                );

            case 3:
                return new NewsArticle(
                    "Emniyetten Rehin Dükkanlarına Eş Zamanlı Denetim!",
                    "Son dönemde artan hırsızlık olayları nedeniyle polis ekipleri tezgahlardaki seri numaralarını sıkı takibe aldı.",
                    ItemCategory.Electronics,
                    NewsImpactType.PoliceCrackdown,
                    -0.15f,
                    2
                );

            case 4:
                return new NewsArticle(
                    "Eski Rock Efsanesinin Vefatı Gitarlara Olan İlgiyi Patlattı!",
                    "Efsanevi gitaristin ardından müzik mağazalarında vintage enstrümanlar ve lambalı amfiler karaborsaya düştü.",
                    ItemCategory.Instrument,
                    NewsImpactType.PriceBoost,
                    0.35f, // +%35
                    3
                );

            case 5:
                return new NewsArticle(
                    "Çip Üretiminde Kriz: İkinci El Telefon ve Konsollar Değerlendi!",
                    "Yurt dışı sevkiyatlarındaki aksamalar nedeniyle mağazalarda sıfır ürün bulunamıyor. Temiz elektronik cihazlar prim yapıyor.",
                    ItemCategory.Electronics,
                    NewsImpactType.PriceBoost,
                    0.20f, // +%20
                    2
                );

            case 6:
                return new NewsArticle(
                    "Nadir Darphane Parası Müzayedede 1 Milyon Dolara Alıcı Buldu!",
                    "Tarihi madeni para ve sikke koleksiyonculuğu yeniden popüler hale geldi. Amatörler eski paraları araştırmaya başladı.",
                    ItemCategory.Coin,

                upgradeCost = 35000f,
                vitrineSlotCount = 15,
                warehouseCapacity = 100,
                hasAppraisalDesk = true,
                hasSecurityCamera = true,
                hasAutomatedStaff = true,
                hasAuctionHouse = false,
                unlockDescription = "Müdür & tezgâhtar çalıştırma imkânı, başka bölgelerde şube açma yetkisi."
            },
            new ShopLevelConfig
            {
                level = 5,
                levelName = "Elit Müzayede & Galeri",
                upgradeCost = 80000f,
                vitrineSlotCount = 25,
                warehouseCapacity = 200,
                hasAppraisalDesk = true,
                hasSecurityCamera = true,
                hasAutomatedStaff = true,
                hasAuctionHouse = true,
                unlockDescription = "Haftalık Açık Artırma (Müzayede) salonu, zengin koleksiyoner kuyruğu."
            }
        };
    }

    public ShopLevelConfig GetCurrentConfig() => levelConfigs.Find(c => c.level == currentShopLevel);

    public bool TryUpgradeShop()
    {
        if (currentShopLevel >= levelConfigs.Count)
        {
            Debug.LogWarning("Dükkân zaten maksimum seviyede!");
            return false;
        }

        ShopLevelConfig nextConfig = levelConfigs.Find(c => c.level == currentShopLevel + 1);
        if (PawnGameManager.Instance.playerCash < nextConfig.upgradeCost)
        {
            Debug.LogWarning($"Yetersiz Bakiye! Geliştirme için ${nextConfig.upgradeCost:N0} gerekiyor.");
            return false;
        }

        PawnGameManager.Instance.playerCash -= nextConfig.upgradeCost;
        currentShopLevel = nextConfig.level;

        ApplyUpgradesToGame(nextConfig);

        Debug.Log($"<color=yellow>🎉 [DÜKKÂN SEVİYE ATLADI]: {nextConfig.levelName} (Seviye {nextConfig.level})!</color>");
        OnShopUpgraded?.Invoke(nextConfig);
        return true;
    }

    private void ApplyUpgradesToGame(ShopLevelConfig cfg)
    {
        if (InventorySystem.Instance != null)
        {
            InventorySystem.Instance.maxCapacity = cfg.warehouseCapacity;
        }
    }
}


[System.Serializable]
public class BranchEmployee
{
    public string employeeID;
    public string employeeName;
    [Range(1, 10)] public int appraisalSkill; // Eşyanın sahtesini anlama yeteneği
    [Range(1, 10)] public int hagglingSkill;  // Ucuza alıp pahalıya satma yeteneği
    public float dailySalary;                 // Günlük yevmiye
    public float totalProfitGenerated;        // Bu elemanın bize kazandırdığı toplam net kâr/zarar

    public BranchEmployee(string name, int appSkill, int hagSkill, float salary)
    {
        employeeID = Guid.NewGuid().ToString().Substring(0, 6);
        employeeName = name;
        appraisalSkill = appSkill;
        hagglingSkill = hagSkill;
        dailySalary = salary;
        totalProfitGenerated = 0f;
    }
}

[System.Serializable]
public class PawnBranchShop
{
    public string branchID;
    public string locationName;          // Örn: "Queens Şubesi", "Brooklyn Bayisi", "Harlem Rehin"
    public float dailyRent;              // Şubenin sabit dükkân kirası
    public BranchEmployee manager;       // Dükkânı yöneten çalışan (Yoksa çalışmaz)
    public float currentCapital;         // Şubenin al-sat için kullandığı kasa sermayesi
    public float cumulativeProfit;       // Şubenin kurulduğundan beri getirdiği net kâr/zarar
    public float yesterdayResult;        // Dünkü kâr veya zarar rakamı

    public bool HasManager => manager != null;
}

public class BranchEmpireSystem : MonoBehaviour
{
    public static BranchEmpireSystem Instance { get; private set; }

    [Header("Aktif Şubeler & Personel")]
    public List<PawnBranchShop> activeBranches = new List<PawnBranchShop>();
    public List<BranchEmployee> availableJobSeekers = new List<BranchEmployee>(); // İşe alınabilecek aday havuzu

    public event Action OnEmpireUpdated;

    private void Awake()
    {
        if (Instance == null) Instance = this;
        else Destroy(gameObject);

        GenerateJobMarketCandidates();
    }

    /// <summary>
    /// Gazeteye/ilanlara iş arayan yeni personeller düşürür.
    /// </summary>
    public void GenerateJobMarketCandidates()
    {
        availableJobSeekers.Clear();
        availableJobSeekers.Add(new BranchEmployee("Marcus Vance", 8, 7, 280f));
        availableJobSeekers.Add(new BranchEmployee("Chloe Zhao", 9, 5, 250f));
        availableJobSeekers.Add(new BranchEmployee("Dmitri Petrov", 4, 8, 200f));
        availableJobSeekers.Add(new BranchEmployee("Jimmy 'Çaylak' Fallon", 2, 3, 90f));
    }

    /// <summary>
    /// Yeni bir bölgede şube açar.
    /// </summary>
    public bool OpenNewBranch(string location, float upfrontCost, float dailyRent, float startingCapital)
    {
        if (ShopUpgradeSystem.Instance.currentShopLevel < 4)
        {
            Debug.LogWarning("Şube açabilmek için ana dükkânın en az Level 4 (Kurumsal) olması gerekir!");
            return false;
        }

        if (PawnGameManager.Instance.playerCash < (upfrontCost + startingCapital))
        {
            Debug.LogWarning("Yeni şube açmak ve kasasına sermaye koymak için yeterli paran yok!");
            return false;
        }

        PawnGameManager.Instance.playerCash -= (upfrontCost + startingCapital);

        PawnBranchShop branch = new PawnBranchShop
        {
            branchID = Guid.NewGuid().ToString().Substring(0, 6),
            locationName = location,
            dailyRent = dailyRent,
            currentCapital = startingCapital,
            cumulativeProfit = 0f,
            manager = null
        };

        activeBranches.Add(branch);
        Debug.Log($"<color=green>🏢 [YENİ ŞUBE AÇILDI]:</color> {location}! Şimdi buraya bir müdür atamalısın.");
        OnEmpireUpdated?.Invoke();
        return true;
    }

    /// <summary>
    /// Boş şubeye işe alım yapar (ETS 2 tarzı personele dükkân teslim etme).
    /// </summary>
    public bool HireEmployeeToBranch(string branchID, BranchEmployee candidate)
    {
        var branch = activeBranches.Find(b => b.branchID == branchID);
        if (branch == null || branch.HasManager) return false;

        branch.manager = candidate;
        availableJobSeekers.Remove(candidate);

        Debug.Log($"<color=cyan>[İŞE ALINDI]:</color> {candidate.employeeName}, {branch.locationName} müdürü olarak işe başladı.");
        OnEmpireUpdated?.Invoke();
        return true;
    }

    /// <summary>
    /// Personeli kovar (ETS 2 Dismiss).
    /// </summary>
    public void FireEmployee(string branchID)
    {
        var branch = activeBranches.Find(b => b.branchID == branchID);
        if (branch == null || !branch.HasManager) return;

        Debug.Log($"<color=red>[KOVULDU]:</color> {branch.manager.employeeName}, {branch.locationName} görevinden kovuldu!");
        branch.manager = null;
        OnEmpireUpdated?.Invoke();
    }

    /// <summary>
    /// Zarar eden veya istenmeyen şubeyi tamamen kapatır (Tasfiye).
    /// </summary>
    public void CloseBranch(string branchID)
    {
        var branch = activeBranches.Find(b => b.branchID == branchID);
        if (branch == null) return;

        // Kalan sermayeyi ana kasaya iade et
        PawnGameManager.Instance.playerCash += Mathf.Max(0f, branch.currentCapital);

        if (branch.HasManager)
        {
            availableJobSeekers.Add(branch.manager); // Eleman işsizler havuzuna döner
        }

        activeBranches.Remove(branch);
        Debug.Log($"<color=grey>[ŞUBE KAPATILDI]:</color> {branch.locationName} feshedildi. Kalan sermaye (${branch.currentCapital:N0}) ana kasaya aktarıldı.");
        OnEmpireUpdated?.Invoke();
    }

    // -----------------------------------------------------------------
    // GECE SİMÜLASYONU: ŞUBELERİN OTOMATİK TİCARETİ VE KÂR/ZARAR DÖKÜMÜ
    // -----------------------------------------------------------------
    /// <summary>
    /// Her gece DaySystem.NightSimulation sırasında şubelerin günlük al-satını işletir.
    /// </summary>
    public void SimulateBranchesNightPerformance()
    {
        foreach (var branch in activeBranches)
        {
            // Eleman yoksa şube kepenk kapatır, sadece kira öder
            if (!branch.HasManager)
            {
                branch.currentCapital -= branch.dailyRent;
                branch.yesterdayResult = -branch.dailyRent;
                branch.cumulativeProfit -= branch.dailyRent;
                Debug.Log($"<color=orange>[{branch.locationName}]:</color> Müdür olmadığı için çalışmadı. Kira zararı: -${branch.dailyRent:N0}");
                continue;
            }

            BranchEmployee emp = branch.manager;

            // 1. Maliyetler: Şube Kirası + Eleman Maaşı
            float dailyExpenses = branch.dailyRent + emp.dailySalary;

            // 2. Performans Çarpanı (ETS 2 Zar Formülü)
            // HagglingSkill kâr marjını belirler, AppraisalSkill sahte mala düşmeme şansını belirler.
            float tradeBaseVolume = UnityEngine.Random.Range(1000f, 3500f);
            float profitMargin = Mathf.Lerp(-0.25f, 0.45f, (emp.hagglingSkill + emp.appraisalSkill) / 20f);

            // Çaylak eleman (%20 ihtimalle sahte mal alır ve içeri girer)
            if (emp.appraisalSkill < 5 && UnityEngine.Random.value < 0.25f)
            {
                profitMargin -= 0.40f; // Sahte mal yutma cezası
                Debug.LogWarning($"[{branch.locationName}]: {emp.employeeName} sahte bir antika satın alarak dükkânı zarara soktu!");
            }

            float grossDailyProfit = tradeBaseVolume * profitMargin;
            float netDailyProfit = grossDailyProfit - dailyExpenses;

            // Kasaya ve istatistiklere işle
            branch.currentCapital += netDailyProfit;
            branch.cumulativeProfit += netDailyProfit;
            branch.yesterdayResult = netDailyProfit;
            emp.totalProfitGenerated += netDailyProfit;

            string color = netDailyProfit >= 0 ? "green" : "red";
            string sign = netDailyProfit >= 0 ? "+" : "";
            Debug.Log($"<color={color}>[{branch.locationName} RAPORU]: Müdür: {emp.employeeName} | Net Bilanço: {sign}${netDailyProfit:N0} (Kasa: ${branch.currentCapital:N0})</color>");

            // Kasa sıfırın altına inerse oyuncunun ana kasasından sübvanse edilir
            if (branch.currentCapital < 0)
            {
                PawnGameManager.Instance.playerCash += branch.currentCapital; // Açığı ana kasadan çek
                branch.currentCapital = 0f;
                Debug.LogWarning($"<color=red>⚠️ [{branch.locationName}] battı! Açık ana kasadan karşılandı. İster kov ister şubeyi kapat!</color>");
            }
            // Kasa çok şişerse fazlalık kârı ana kasaya aktar (Temettü)
            else if (branch.currentCapital > 15000f)
            {
                float dividend = branch.currentCapital - 10000f;
                branch.currentCapital = 10000f;
                PawnGameManager.Instance.playerCash += dividend;
                Debug.Log($"<color=green>💰 [{branch.locationName}] kâr payı aktardı: +${dividend:N0} ana kasaya eklendi.</color>");
            }
        }

        OnEmpireUpdated?.Invoke();
    }
}


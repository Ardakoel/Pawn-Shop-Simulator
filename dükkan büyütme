[System.Serializable]
public class CollectionItemRequirement
{
    public string targetTemplateID; // Gerekli eşya ID'si (Örn: "watch_rolex_1968")
    public string displayName;      // UI'da görünecek ad (Örn: "1968 Submariner")
    public bool isRegistered;       // Oyuncu bu parçayı koleksiyona kilitledi mi?
    public string registeredItemID; // Kilitlenen envanter parçasının UniqueID'si
}

[System.Serializable]
public class CollectionSet
{
    public string setID;
    public string setName;
    public ItemCategory category;
    [TextArea(2, 3)]
    public string description;

    [Header("Gereksinimler")]
    public List<CollectionItemRequirement> requirements = new List<CollectionItemRequirement>();

    [Header("Tamamlama Ödülleri")]
    public float completionCashBonus;      // Nakit para ödülü
    public float permanentReputationBonus; // Kalıcı itibar artışı
    public string completionPerkName;      // Kazanılan pasif yetenek/unvan
    public bool isCompleted;

    public int RegisteredCount => requirements.FindAll(r => r.isRegistered).Count;
    public int TotalRequired => requirements.Count;
    public float ProgressPercentage => (float)RegisteredCount / TotalRequired * 100f;
}


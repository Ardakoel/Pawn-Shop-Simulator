    /// <summary>
    /// Envanterdeki bir eşyayı koleksiyon setine kilitler.
    /// Eşya orijinal olmalıdır; sahte veya replika eşyalar koleksiyona kabul edilmez.
    /// </summary>
    public bool RegisterItemToCollection(InventoryItem item, string setID)
    {
        // 1. Orijinallik Filtresi
        if (item.authenticity != AuthenticityType.Authentic)
        {
            Debug.LogWarning("<color=red>[KOLEKSİYON REDDİ]:</color> Sahte veya parçası değiştirilmiş eşyalar koleksiyon vitrinine konulamaz!");
            return false;
        }

        CollectionSet targetSet = collectionSets.Find(s => s.setID == setID);
        if (targetSet == null || targetSet.isCompleted) return false;

        // 2. Eşleşen boş gereksinimi bul
        CollectionItemRequirement req = targetSet.requirements.Find(r => r.targetTemplateID == item.itemTemplateID && !r.isRegistered);

        if (req != null)
        {
            req.isRegistered = true;
            req.registeredItemID = item.uniqueID;

            // Eşyayı normal satış envanterinden çıkarıp koleksiyon albümüne kilitle
            InventorySystem.Instance.RemoveItem(item.uniqueID);

            Debug.Log($"<color=green>[KOLEKSİYONA EKLENDİ]:</color> {item.itemName} -> {targetSet.setName} (%{targetSet.ProgressPercentage:0})");
            OnItemAddedToCollection?.Invoke(targetSet, req);

            // Tamamlanma Kontrolü
            CheckSetCompletion(targetSet);
            return true;
        }

        Debug.LogWarning("Bu eşya seçilen koleksiyonun aranan parçaları arasında bulunmuyor.");
        return false;
    }

    /// <summary>
    /// Setin tamamlanıp tamamlanmadığını kontrol eder ve ödülleri dağıtır.
    /// </summary>
    private void CheckSetCompletion(CollectionSet set)
    {
        if (set.RegisteredCount == set.TotalRequired && !set.isCompleted)
        {
            set.isCompleted = true;

            // 1. Para Ödülü
            if (PawnGameManager.Instance != null)
            {
                PawnGameManager.Instance.playerCash += set.completionCashBonus;
            }

            // 2. İtibar Ödülü
            if (ReputationSystem.Instance != null)
            {
                ReputationSystem.Instance.customerTrust = Mathf.Clamp(ReputationSystem.Instance.customerTrust + set.permanentReputationBonus, 0f, 100f);
                ReputationSystem.Instance.marketReputation = Mathf.Clamp(ReputationSystem.Instance.marketReputation + set.permanentReputationBonus, 0f, 100f);
            }

            Debug.Log($"<color=gold>🏆🏆🏆 [KOLEKSİYON TAMAMLANDI!] 🏆🏆🏆\n" +
                      $"{set.setName} tamamlandı!\n" +
                      $"Ödül: +${set.completionCashBonus:N0} Nakit | +{set.permanentReputationBonus} İtibar\n" +
                      $"Pasif Yetenek Açıldı: {set.completionPerkName}</color>");

            OnCollectionCompleted?.Invoke(set);
        }
    }

    public List<CollectionSet> GetAllSets() => collectionSets;
}


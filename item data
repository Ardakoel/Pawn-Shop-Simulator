using UnityEngine;

public enum ItemCategory
{
    Jewelry,      // Mücevher & Değerli Taşlar
    Electronics,  // Telefon, Konsol, Bilgisayar
    Antiques,     // Tarihi objeler, Madalyalar, Paralar
    Collectibles  // Çizgi romanlar, Plaklar, Spor kartları
}

public enum ItemRarity
{
    Common,       // Sıradan
    Uncommon,     // Nadirce
    Rare,         // Nadir
    Epic,         // Çok Nadir / Koleksiyonluk
    Legendary     // Efsanevi / Müzelik
}

public enum ItemCondition
{
    Broken,       // Kırık / Bozuk (Değeri çok kırar)
    Poor,         // Kötü / Yıpranmış
    Fair,         // İdare Eder / Orta
    Good,         // İyi
    Mint          // Sıfır Ayarında / Kusursuz
}

public enum ItemAuthenticity
{
    Authentic,    // Orijinal ürün
    Counterfeit,  // Sahte / Taklit / Çakma
    Stolen        // Çalıntı / Sıcak mal
}

[CreateAssetMenu(fileName = "NewItemData", menuName = "PawnShop/Item Data")]
public class ItemData : ScriptableObject
{
    [Header("Temel Kimlik Bilgileri")]
    [Tooltip("Örn: ITM_ROLEX_01 veya benzersiz kod")]
    public string itemID;
    public string itemName;
    public ItemCategory category;
    public Sprite icon;

    [Header("Fiyatlandırma & Değer")]
    [Tooltip("Eşyanın baz/liste piyasa değeri")]
    public float baseValue;
    [Tooltip("En kötü durumda (hasarlı/çaresiz pazarlık) inebileceği dip fiyat")]
    public float minValue;
    [Tooltip("Koleksiyoncuya veya kusursuz durumda satılabilecek tavan fiyat")]
    public float maxValue;

    [Header("Eşya Durumu & Orijinallik")]
    public ItemRarity rarity;
    public ItemCondition condition;
    public ItemAuthenticity authenticity;

    [Header("Fiziksel & Teknik Detaylar")]
    public string brand;             // Marka (Örn: Rolex, Sony, Fender)
    public int age;                  // Eşyanın yaşı (Örn: 25 yaşında vintage amfi)
    public float weight;             // Ağırlık (kg cinsinden)
    public string serialNumber;      // Seri Numarası (Sahte/Çalıntı kontrolü için)

    /// <summary>
    /// Eşyanın kondisyon çarpanına göre güncel piyasa değerini hesaplar.
    /// </summary>
    public float CalculateCurrentValue()
    {
        float conditionMultiplier = 1.0f;

        switch (condition)
        {
            case ItemCondition.Broken:  conditionMultiplier = 0.20f; break; // %80 değer kaybı
            case ItemCondition.Poor:    conditionMultiplier = 0.50f; break; // %50 değer kaybı
            case ItemCondition.Fair:    conditionMultiplier = 0.75f; break;
            case ItemCondition.Good:    conditionMultiplier = 1.00f; break;
            case ItemCondition.Mint:    conditionMultiplier = 1.25f; break; // %25 prim yapar
        }

        // Sahte ürünlerin gerçek değeri taban fiyatın çok altındadır
        if (authenticity == ItemAuthenticity.Counterfeit)
        {
            conditionMultiplier *= 0.10f; // Sahteyse değeri yerin dibine girer
        }

        float calculated = baseValue * conditionMultiplier;
        return Mathf.Clamp(calculated, minValue, maxValue);
    }
}


using System;
using System.Collections.Generic;
using System.IO;
using UnityEngine;

public class SaveSystem : MonoBehaviour
{
    public static SaveSystem Instance { get; private set; }

    private const string SAVE_FILE_NAME = "gamesave.json";
    private const string BACKUP_FILE_NAME = "gamesave.bak";

    private string SaveFilePath => Path.Combine(Application.persistentDataPath, SAVE_FILE_NAME);
    private string BackupFilePath => Path.Combine(Application.persistentDataPath, BACKUP_FILE_NAME);

    public event Action OnSaveCompleted;
    public event Action OnLoadCompleted;

    private void Awake()
    {
        if (Instance == null)
        {
            Instance = this;
            DontDestroyOnLoad(gameObject);
        }
        else
        {
            Destroy(gameObject);
        }
    }

    /// <summary>
    /// Tüm alt sistemlerden veriyi çeker ve JSON olarak diske atomik yazar.
    /// </summary>
    public bool SaveGame()
    {
        try
        {
            SaveData data = new SaveData
            {
                saveDateTimestamp = DateTime.UtcNow.ToString("o"),
                masterRandomSeed = RandomService.Instance != null ? RandomService.Instance.GetCurrentMasterSeed() : 1337,

                // 1. Gün & Faz
                currentDay = DaySystem.Instance != null ? DaySystem.Instance.currentDay : 1,
                currentPhase = DaySystem.Instance != null ? DaySystem.Instance.currentPhase : DayPhase.MorningBriefing,

                // 2. Para & Dükkân Kademesi
                playerCash = PawnGameManager.Instance != null ? PawnGameManager.Instance.playerCash : 0f,
                currentShopLevel = ShopUpgradeSystem.Instance != null ? ShopUpgradeSystem.Instance.currentShopLevel : 1,

                // 3. Envanter
                inventoryItems = InventorySystem.Instance != null ? InventorySystem.Instance.GetAllItems() : new List<InventoryItem>()
            };

            // 4. İtibar Eksenleri
            if (ReputationSystem.Instance != null)
            {
                data.honesty = ReputationSystem.Instance.honesty;
                data.customerTrust = ReputationSystem.Instance.customerTrust;
                data.marketReputation = ReputationSystem.Instance.marketReputation;
                data.policeReputation = ReputationSystem.Instance.policeReputation;
                data.currentTier = ReputationSystem.Instance.currentTier;
            }

            // 5. Şubeler ve Personel
            if (BranchEmpireSystem.Instance != null)
            {
                data.activeBranches = new List<PawnBranchShop>(BranchEmpireSystem.Instance.activeBranches);
                data.availableJobSeekers = new List<BranchEmployee>(BranchEmpireSystem.Instance.availableJobSeekers);
            }

            // 6. Müşteri İlişkileri & Müşteri Hafızası
            if (CustomerRelationshipSystem.Instance != null)
            {
                data.customerRelationships = CustomerRelationshipSystem.Instance.GetProfilesForSave();
            }

            if (CustomerMemorySystem.Instance != null)
            {
                data.customerMemories = CustomerMemorySystem.Instance.GetMemoriesForSave();
            }

            // 7. Koleksiyonlar
            if (CollectionSystem.Instance != null)
            {
                data.collectionSets = new List<CollectionSet>(CollectionSystem.Instance.GetAllSets());
            }

            // 8. İşlem Geçmişi & İstatistikler
            if (TransactionSystem.Instance != null)
            {
                data.transactionHistory = TransactionSystem.Instance.GetAllHistory();
            }

            if (StatisticsSystem.Instance != null)
            {
                data.statistics = StatisticsSystem.Instance.RebuildAndGetStats();
            }

            // JSON Serializasyonu
            string json = JsonUtility.ToJson(data, true);

            // Güvenli (Atomic) Dosya Yazımı
            if (File.Exists(SaveFilePath))
            {
                File.Copy(SaveFilePath, BackupFilePath, true);
            }

            File.WriteAllText(SaveFilePath, json);

            Debug.Log($"<color=green>💾 [KAYIT TAMAMLANDI]:</color> Gün {data.currentDay} kaydedildi. Konum: {SaveFilePath}");
            OnSaveCompleted?.Invoke();
            return true;
        }
        catch (Exception ex)
        {
            Debug.LogError($"[KAYIT HATASI]: {ex.Message}\n{ex.StackTrace}");
            return false;
        }
    }

    /// <summary>
    /// Diskteki JSON dosyasını okur ve tüm sistemleri kaydedilmiş duruma getirir.
    /// </summary>
    public bool LoadGame()
    {
        string path = SaveFilePath;

        if (!File.Exists(path))
        {
            if (File.Exists(BackupFilePath))
            {
                Debug.LogWarning("[YEDEK ÇAĞRILDI]: Ana kayıt eksik, .bak dosyasından yükleniyor...");
                path = BackupFilePath;
            }
            else
            {
                Debug.LogWarning("Kayıt dosyası bulunamadı.");
                return false;
            }
        }

        try
        {
            string json = File.ReadAllText(path);
            SaveData data = JsonUtility.FromJson<SaveData>(json);

            // 1. Tohum Motorunu Senkronize Et
            if (RandomService.Instance != null)
            {
                RandomService.Instance.InitializeSeedSystem(data.masterRandomSeed);
            }

            // 2. Gün & Faz
            if (DaySystem.Instance != null)
            {
                DaySystem.Instance.currentDay = data.currentDay;
                DaySystem.Instance.currentPhase = data.currentPhase;
            }

            // 3. Para & Seviye
            if (PawnGameManager.Instance != null)
            {
                PawnGameManager.Instance.playerCash = data.playerCash;
            }

            if (ShopUpgradeSystem.Instance != null)
            {
                ShopUpgradeSystem.Instance.currentShopLevel = data.currentShopLevel;
            }

            // 4. İtibarı Geri Yükle
            if (ReputationSystem.Instance != null)
            {
                ReputationSystem.Instance.honesty = data.honesty;
                ReputationSystem.Instance.customerTrust = data.customerTrust;
                ReputationSystem.Instance.marketReputation = data.marketReputation;
                ReputationSystem.Instance.policeReputation = data.policeReputation;
                ReputationSystem.Instance.currentTier = data.currentTier;
            }

            // 5. Envanteri Sıfırla ve Doldur
            if (InventorySystem.Instance != null)
            {
                InventorySystem.Instance.ClearInventory();
                foreach (var item in data.inventoryItems)
                {
                    InventorySystem.Instance.AddItem(item);
                }
            }

            // 6. Şubeler ve Personeli Geri Yükle
            if (BranchEmpireSystem.Instance != null)
            {
                BranchEmpireSystem.Instance.activeBranches = data.activeBranches ?? new List<PawnBranchShop>();
                BranchEmpireSystem.Instance.availableJobSeekers = data.availableJobSeekers ?? new List<BranchEmployee>();
            }

            // 7. Müşteri İlişkileri ve Hafızayı Geri Yükle
            if (CustomerRelationshipSystem.Instance != null && data.customerRelationships != null)
            {
                CustomerRelationshipSystem.Instance.RestoreProfiles(data.customerRelationships);
            }

            if (CustomerMemorySystem.Instance != null && data.customerMemories != null)
            {
                CustomerMemorySystem.Instance.RestoreMemories(data.customerMemories);
            }

            // 8. Koleksiyonları Geri Yükle
            if (CollectionSystem.Instance != null && data.collectionSets != null)
            {
                CollectionSystem.Instance.RestoreCollections(data.collectionSets);
            }

            // 9. İşlem Geçmişini Geri Yükle
            if (TransactionSystem.Instance != null && data.transactionHistory != null)
            {
                TransactionSystem.Instance.RestoreHistory(data.transactionHistory);
            }

            Debug.Log($"<color=cyan>📂 [YÜKLEME BAŞARILI]:</color> Gün {data.currentDay} yüklendi. Nakit: ${data.playerCash:N0}, Envanter: {data.inventoryItems.Count} parça.");
            OnLoadCompleted?.Invoke();
            return true;
        }
        catch (Exception ex)
        {
            Debug.LogError($"[YÜKLEME HATASI]: {ex.Message}\n{ex.StackTrace}");
            return false;
        }
    }

    public bool HasSaveFile() => File.Exists(SaveFilePath) || File.Exists(BackupFilePath);

    public void DeleteSaveData()
    {
        if (File.Exists(SaveFilePath)) File.Delete(SaveFilePath);
        if (File.Exists(BackupFilePath)) File.Delete(BackupFilePath);
        Debug.Log("<color=red>[SAVE SİLİNDİ]:</color> Kayıt dosyaları temizlendi.");
    }
}

public List<CustomerRelationshipProfile> GetProfilesForSave() => new List<CustomerRelationshipProfile>(profiles);
public void RestoreProfiles(List<CustomerRelationshipProfile> loadedProfiles) => profiles = loadedProfiles;

public List<CustomerMemoryRecord> GetMemoriesForSave() => new List<CustomerMemoryRecord>(memoryDatabase);
public void RestoreMemories(List<CustomerMemoryRecord> loadedMemories) => memoryDatabase = loadedMemories;

public void RestoreCollections(List<CollectionSet> loadedSets) => collectionSets = loadedSets;

public void RestoreHistory(List<TransactionRecord> loadedHistory) => transactionHistory = loadedHistory;



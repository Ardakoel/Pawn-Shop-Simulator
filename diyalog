    /// <summary>
    /// Müşterinin kişiliğine ve o anki duruma en uygun diyaloğu seçer.
    /// </summary>
    public static string GetDialogue(CustomerTraits traits, DialogueContext context, float extraPriceInfo = 0f)
    {
        switch (context)
        {
            case DialogueContext.Greeting:
                return ResolveGreeting(traits);

            case DialogueContext.CounterOffer:
                return ResolveCounterOffer(traits, extraPriceInfo);

            case DialogueContext.LosingPatience:
                return GetRandomLine(ImpatientWarningLines);

            case DialogueContext.DealAccepted:
                return ResolveAccepted(traits);

            case DialogueContext.WalkAway:
            case DialogueContext.LowballRejection:
                return GetRandomLine(WalkAwayLines);

            default:
                return "Ne diyorsun, anlaşabilecek miyiz?";
        }
    }

    private static string ResolveGreeting(CustomerTraits traits)
    {
        // 1. Öncelik: Borçlu + Acil Nakit Baskısı
        if (traits.debt > 65 && traits.urgency > 65 && traits.needMoney > 65)
            return GetRandomLine(DesperateGreetingLines);

        // 2. Öncelik: Tok Satıcı / Kibir
        if (traits.pride > 70 && traits.needMoney < 45)
            return GetRandomLine(ProudSellerGreetingLines);

        // 3. Öncelik: Eşyaya Duygusal Bağ
        if (traits.itemAttachment > 75)
            return GetRandomLine(AttachedGreetingLines);

        // 4. Öncelik: Şüpheli / Çakma Ürün Satıcısı
        if (traits.honesty < 35 && traits.greed > 65)
            return GetRandomLine(ShadyGreetingLines);

        // 5. Öncelik: Piyasayı Bilen Esnaf Müşteri
        if (traits.itemKnowledge > 80 && traits.hagglingSkill > 70)
            return GetRandomLine(SavvyGreetingLines);

        // Varsayılan
        return GetRandomLine(NeutralGreetingLines);
    }

    private static string ResolveCounterOffer(CustomerTraits traits, float counterPrice)
    {
        string priceTag = counterPrice > 0 ? $" Benim son teklifim ${counterPrice:N0}." : "";

        if (traits.pride > 70)
            return GetRandomLine(ProudCounterLines) + priceTag;

        if (traits.itemAttachment > 70)
            return GetRandomLine(AttachedCounterLines) + priceTag;

        if (traits.desperation > 65 || traits.debt > 70)
            return GetRandomLine(DesperateCounterLines) + priceTag;

        return $"Bu teklif çok düşük. Senin için ${counterPrice:N0} seviyesine inebilirim.";
    }

    private static string ResolveAccepted(CustomerTraits traits)
    {
        if (traits.desperation > 65)
            return GetRandomLine(DesperateAcceptedLines);

        if (traits.pride > 70)
            return GetRandomLine(ProudAcceptedLines);

        if (traits.itemAttachment > 70)
            return GetRandomLine(AttachedAcceptedLines);

        return "Fiyat gayet adil. El sıkışalım, anlaştık!";
    }

    private static string GetRandomLine(string[] lines)
    {
        if (lines == null || lines.Length == 0) return "...";
        return lines[Random.Range(0, lines.Length)];
    }
}



using System.Collections.Generic;
using UnityEngine;

public static class DialogueGenerator
{
    /// <summary>
    /// Müşterinin zıt veya pekiştirici özelliklerinin kombinasyonuna göre dinamik replik üretir.
    /// </summary>
    public static string GenerateContextualDialogue(CustomerTraits traits, DialogueContext context, float extraPrice = 0f)
    {
        switch (context)
        {
            case DialogueContext.Greeting:
                return GenerateGreetingDialogue(traits);

            case DialogueContext.CounterOffer:
                return GenerateCounterOfferDialogue(traits, extraPrice);

            case DialogueContext.LowballRejection:
                return GenerateLowballDialogue(traits);

            case DialogueContext.LosingPatience:
                return GenerateImpatienceDialogue(traits);

            case DialogueContext.DealAccepted:
                return GenerateAcceptedDialogue(traits);

            default:
                return "Pekala, bu teklife ne diyorsun?";
        }
    }

    // =========================================================================
    // 1. GİRİŞ VE AÇILIŞ DİYALOGLARI (ÖZELLİK KOMBİNASYONLARI)
    // =========================================================================
    private static string GenerateGreetingDialogue(CustomerTraits traits)
    {
        // KOMBİNASYON 1: Aciliyet Yüksek + Gurur Yüksek (Çaresiz ama Burnu Havada)
        if (traits.urgency > 75 && traits.pride > 75)
        {
            return PickRandom(new string[]
            {
                "Bugün bu parayı çıkarmak zorundayım ama beni köşeye sıkışmış görüp aptal yerine koymaya kalkmayın.",
                "Zamanım çok dar, acil nakite ihtiyacım var. Yine de değerinin altında tek kuruşa bırakmam, bilginiz olsun.",
                "Acelem var diye beni ezebileceğinizi sanmayın. Ciddi ve dürüst bir teklifle gelin, hemen anlaşalım."
            });
        }

        // KOMBİNASYON 2: Yüksek Borç/Çaresizlik + Eşyaya Aşırı Bağlılık (Vicdan Azabı Çeken Satıcı)
        if ((traits.debt > 75 || traits.desperation > 75) && traits.itemAttachment > 75)
        {
            return PickRandom(new string[]
            {
                "Gırtlağıma kadar borca batmamış olsam bu yadigârı dünya para verseler kapıdan içeri sokmazdım...",
                "Bunu buraya getirmek ciğerimi söküyor ama icra kapıda. Lütfen hak ettiği bir para verin de içim rahat etsin.",
                "Mecbur kalmasam ailemin hatırasını asla masaya koymazdım. Beni daha fazla yıpratmadan adil bir fiyat verin."
            });
        }

        // KOMBİNASYON 3: Açgözlülük Yüksek + Dürüstlük Düşük (Sıcak Paracı / Dolandırıcı Tipi)
        if (traits.greed > 75 && traits.honesty < 35)
        {
            return PickRandom(new string[]
            {
                "Soru sormayı bırak da paraya odaklan usta. Sağlam bir para sayarsan ikimiz de bu işten karlı çıkarız.",
                "Kutusunu, geçmişini falan kurcalama; mal ortada. Bana peşin güzel bir para ver, hemen el sıkışalım.",
                "Şans ayağına geldi. Benden bu fiyata al, yarın vitrinde iki katına okutursun. Anla işte vaziyeti."
            });
        }

        // KOMBİNASYON 4: Paraya İhtiyaç Yok + Yüksek Gurur + Bilgili (Tok Koleksiyoner)
        if (traits.needMoney < 35 && traits.pride > 75 && traits.itemKnowledge > 70)
        {
            return PickRandom(new string[]
            {
                "Paraya zerre ihtiyacım yok. Sadece koleksiyonumdaki bu nadir parçanın kıymetini bilecek bir vitrin arıyorum.",
                "Bunun hangi döneme ait olduğunu ve gerçek değerini çok iyi biliyorum. Komik rakamlarla esnaflığınızı küçültmeyin.",
                "İster alırım ister salondaki vitrinime geri koyarım, hiç dert değil. Gerçek piyasa değerini konuşacaksanız buyrun."
            });
        }

        // KOMBİNASYON 5: Bilgisiz ama Aşırı Şüpheci/Kibirli
        if (traits.itemKnowledge < 35 && traits.pride > 75)
        {
            return PickRandom(new string[]
            {
                "Bu işlerin piyasasını pek bilmem ama kimseye de malımı üç kuruşa kaptıracak kadar saf değilim.",
                "Antikadan anlamam ama ailemden kalma değerli bir parça olduğunu biliyorum. Beni kandırmaya kalkmayın."
            });
        }

        // KOMBİNASYON 6: Sadece Saf Aciliyet ve Çaresizlik
        if (traits.urgency > 80 || traits.desperation > 80)
        {
            return PickRandom(new string[]
            {
                "Bugün bu eşyayı kesinlikle satmam gerekiyor. Lütfen beni fazla uğraştırmadan elinizden geleni verin.",
                "Saat işliyor, akşama kadar bu parayı denkleştirmem şart. Ne kadar verirseniz verin makul olsun yeter."
            });
        }

        // KOMBİNASYON 7: Sadece Saf Gurur
        if (traits.pride > 80)
        {
            return PickRandom(new string[]
            {
                "Değerinin altında tek kuruş dahi istemiyorum. Kalitenin bir bedeli vardır.",
                "Ucuza gidecek tek bir çöpüm dahi yok. Hak ettiği rakam neyse onu konuşuruz."
            });
        }

        // KOMBİNASYON 8: Sadece Saf Eşyaya Bağlılık
        if (traits.itemAttachment > 80)
        {
            return PickRandom(new string[]
            {
                "Bunu satmak içimi parçalıyor... Lütfen ona sıradan bir teneke muamelesi yapmayın.",
                "Bunun bende çok büyük hatırası var. Parası bir yana, emanet edecek doğru yeri arıyorum."
            });
        }

        // Standart Varsayılan
        return "Merhaba usta. Elimde böyle bir parça var, dükkanınızda değerlendirmek istiyorum.";
    }

    // =========================================================================
    // 2. PAZARLIK & KARŞI TEKLİF DİYALOGLARI (FİYAT DİRENCİ)
    // =========================================================================
    private static string GenerateCounterOfferDialogue(CustomerTraits traits, float counterPrice)
    {
        string priceStr = counterPrice > 0 ? $" Son olarak ${counterPrice:N0} olur." : "";

        // Acil nakit lazım ama gururu da yüksek (İkilemde)
        if (traits.urgency > 70 && traits.pride > 70)
        {
            return $"Zamanım olsaydı bu teklife güler geçerdim! Sırf acelem var diye bir adım atıyorum.{priceStr}";
        }

        // Eşyaya bağlı ama borçlu (Hüzünlü indirim)
        if (traits.itemAttachment > 70 && traits.debt > 70)
        {
            return $"Zaten yadigârı sattığıma yanıyorum, bari bu kadar öldürme be esnafım...{priceStr}";
        }

        // Tok satıcı (Dirençli)
        if (traits.pride > 75 && traits.needMoney < 40)
        {
            return $"Pazarlık adabını aşmayın. İneneceğim tek kademe budur, fazlasını teklif dahi etmeyin.{priceStr}";
        }

        // Sabrı azalan esnaf tipi
        if (traits.hagglingSkill > 70)
        {
            return $"İkimiz de bu işin kurallarını biliyoruz. Seni üzmem ama kendimi de ezdirmem.{priceStr}";
        }

        return $"Bu teklif çok düşük kaldı. Senin hatırına şu seviyeye inebilirim:{priceStr}";
    }

    // =========================================================================
    // 3. ÇOK DÜŞÜK TEKLİF HAKARET TEPKİLERİ (LOWBALL REJECTION)
    // =========================================================================
    private static string GenerateLowballDialogue(CustomerTraits traits)
    {
        if (traits.pride > 75 && traits.urgency > 70)
        {
            return "Köşeye sıkıştığımı anlayıp leş kargası gibi çökmeye çalıştın değil mi?! Aç kalırım yine sana vermem!";
        }

        if (traits.pride > 75)
        {
            return "Sen benim aklımla alay mı ediyorsun?! Bu teklif bir esnafa değil, ancak bir dolandırıcıya yakışır!";
        }

        if (traits.itemAttachment > 75)
        {
            return "Babamın emanetine bu parayı biçmek resmen hakarettir! Al eşyanı başına çal!";
        }

        return "Bu kadar da ölücülük olmaz! Vaktimi çaldınız, gidiyorum!";
    }

    // =========================================================================
    // 4. SABIR TÜKENİRKEN (PATIENCE RUNNING OUT)
    // =========================================================================
    private static string GenerateImpatienceDialogue(CustomerTraits traits)
    {
        if (traits.urgency > 75)
        {
            return "Zamanım bitiyor diyorum, sen hala üç kuruşun hesabını yapıyorsun! Son teklifin ne, söyle!";
        }

        if (traits.pride > 75)
        {
            return "Sabrımı sınıyorsunuz. Ben buraya laf işitmeye gelmedim. Ciddi olun ya da çıkıp gideyim!";
        }

        return "Gittikçe sabrımı tüketiyorsun. Ya aklı başında bir para ver ya da eşyamı geri ver!";
    }

    // =========================================================================
    // 5. ANLAŞMA SAĞLANDIĞINDA (DEAL ACCEPTED)
    // =========================================================================
    private static string GenerateAcceptedDialogue(CustomerTraits traits)
    {
        // Acil + Gururlu: İstemeye istemeye kabul ediş
        if (traits.urgency > 70 && traits.pride > 70)
        {
            return "Pekala... Durumum elvermediği için kabul ediyorum. Ama şunu bil ki bu eşyanın hakkı bu değildi.";
        }

        // Borçlu + Çaresiz: Rahatlama
        if (traits.desperation > 70)
        {
            return "Çok şükür... Bu para beni bu akşamlık kurtarır. Say parayı hemen usta, sağ olasın.";
        }

        // Tok satıcı: Memnuniyet
        if (traits.pride > 75)
        {
            return "Adil bir esnafla iş yapmak güzel. Malımın değerini teslim ettiniz, el sıkışalım.";
        }

        // Bağlı: Hüzünlü kabulleniş
        if (traits.itemAttachment > 75)
        {
            return "Anlaştık... Lütfen ona iyi bakın. Gerçekten ailemiz için çok kıymetliydi.";
        }

        return "Fiyat gayet uygun. Anlaştık, hayırlı olsun!";
    }

    private static string PickRandom(string[] array)
    {
        if (array == null || array.Length == 0) return "";
        return array[Random.Range(0, array.Length)];
    }
}


